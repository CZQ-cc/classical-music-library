---
/**
 * 首页(暗色沉浸版):本周唱片 Hero + 编辑导语 + 编辑精选 + 入门路线 + 作曲家
 * 视觉参考:流媒体播放器界面;数据逻辑与内容模型不变
 */
import { getCollection } from 'astro:content';
import Home from '../layouts/Home.astro';
import Cover from '../components/Cover.astro';
import Stars from '../components/Stars.astro';
import { must, lineupOfRecording } from '../utils/data';

const albums = (await getCollection('albums')).sort((a, b) => b.data.rating - a.data.rating);
const featured = albums.filter((a) => a.data.featured);
const hero = featured[0] ?? albums[0];
const rest = featured.filter((a) => a.id !== hero.id);

// Hero 唱片:阵容 / 录音年份 / 编辑导语首段
const heroRecs = await Promise.all(hero.data.recordings.map((s: string) => must('recordings', s)));
const heroLineup = await lineupOfRecording(heroRecs[0]);
const heroYears = [...new Set(heroRecs.map((r) => r.data.recording_year))].join(' / ');
const heroEditorial = hero.data.editorial.split(/\n\s*\n/)[0].trim();
const heroWorkSlug = heroRecs[0].data.works[0];

// 编辑精选卡:主录音阵容
const restCards = await Promise.all(
  rest.map(async (al) => {
    const rec = await must('recordings', al.data.recordings[0]);
    return { album: al, lineup: await lineupOfRecording(rec) };
  }),
);

// 入门路线(前 6 站)+ 作曲家
const collection = (await getCollection('collections'))[0];
const routeItems = collection
  ? await Promise.all(
      collection.data.items.slice(0, 6).map(async (it: any) => ({
        note: it.note,
        album: await must('albums', it.album),
      })),
    )
  : [];
const composers = (await getCollection('composers')).sort((a, b) => a.data.birth.localeCompare(b.data.birth));
---

<Home
  feature={{ title: hero.data.title, lineup: heroLineup, href: `/albums/${hero.id}/`, rating: hero.data.rating }}
>
  <!-- Hero:本周唱片 -->
  <section class="hero" id="hero">
    <div class="hero-cover">
      <Cover cover={hero.data.cover} label={hero.data.label} title={hero.data.title} artist={heroLineup} />
    </div>
    <div class="hero-info">
      <p class="eyebrow-dark">{hero.data.label} · {hero.data.release_year}</p>
      <h1>{hero.data.title}</h1>
      {hero.data.title_en && <p class="hero-en">{hero.data.title_en}</p>}
      <div class="hero-actions">
        <a class="pill" href={`/albums/${hero.id}/`}>
          <svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor">
            <path d="M2 1l9 5-9 5z"></path>
          </svg>
          开始聆听
        </a>
        <a class="ghost-btn" href={`/works/${heroWorkSlug}/`}>作品与版本比较</a>
      </div>
      <p class="hero-lineup">{heroLineup}</p>
      <p class="hero-copy">© {hero.data.label} · 录音 {heroYears}</p>
    </div>
  </section>

  <!-- 编辑导语(对应参考图斜体段落) -->
  <p class="hero-editorial">{heroEditorial}</p>

  <!-- 编辑精选 -->
  <section class="sec" id="choice">
    <div class="sec-title">
      <span class="sec-zh">编辑精选</span>
      <span class="sec-en">Editor's Choice</span>
    </div>
    <div class="card-grid-dark">
      {
        restCards.map(({ album, lineup }) => (
          <a class="dcard" href={`/albums/${album.id}/`}>
            <Cover
              cover={album.data.cover}
              label={album.data.label}
              title={album.data.title}
              artist={lineup}
            />
            <div class="dc-label">{album.data.label} · {album.data.release_year}</div>
            <div class="dc-title">{album.data.title}</div>
            <div class="dc-sub">{lineup}</div>
            <div class="dc-meta">
              <Stars rating={album.data.rating} />
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 入门路线 -->
  <section class="sec" id="start">
    <div class="sec-title">
      <span class="sec-zh">从这里开始</span>
      <span class="sec-en">Getting Started</span>
    </div>
    <ol class="route">
      {
        routeItems.map(({ album, note }, i) => (
          <li>
            <span class="rn">{String(i + 1).padStart(2, '0')}</span>
            <a class="rt" href={`/albums/${album.id}/`}>
              {album.data.title}
            </a>
            {note && <span class="snote">{note}</span>}
          </li>
        ))
      }
    </ol>
    {
      collection && (
        <a class="more-link" href={`/collections/${collection.id}/`}>
          查看完整路线({collection.data.items.length} 张)→
        </a>
      )
    }
  </section>

  <!-- 作曲家速览 -->
  <section class="sec" id="composers">
    <div class="sec-title">
      <span class="sec-zh">作曲家</span>
      <span class="sec-en">Composers</span>
    </div>
    <div class="comp-row">
      {
        composers.map((c) => (
          <a class="comp" href={`/composers/${c.id}/`}>
            <span class="mono">{c.data.monogram}</span>
            {c.data.name}
          </a>
        ))
      }
    </div>
  </section>

  <footer class="home-foot">
    <p>聆听经典 · The Art of Listening — 不存储音频;乐评有出处,指南有坐标。<a href="/about/">版权与内容说明</a></p>
  </footer>
</Home>
